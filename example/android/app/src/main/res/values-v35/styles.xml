<resources>

    <!-- Android 15 (API 35) only. targetSdk 35 forces edge-to-edge, which makes
         the app draw behind the system bars: the message input overlaps the
         navigation buttons and RN 0.74's adjustResize no longer lifts content
         above the keyboard. Opting out restores opaque system bars + classic
         inset behavior (same as Android 14 and below, where the UI already
         works). No effect on API < 35 (they use values/styles.xml). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

</resources>
