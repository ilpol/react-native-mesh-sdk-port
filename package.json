{
  "name": "react-native-mesh-sdk",
  "version": "0.1.0",
  "description": "Bluetooth mesh messaging for React Native, ported from the native BitChat cores (Android + iOS).",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "scripts",
    "react-native-mesh-sdk.podspec",
    "!**/__tests__",
    "!**/.gradle",
    "!**/build"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepare": "bob build",
    "sync-core": "bash scripts/sync-core.sh"
  },
  "keywords": [
    "react-native",
    "bluetooth",
    "mesh",
    "ble",
    "offline",
    "messaging",
    "bitchat"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.3.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "codegenConfig": {
    "name": "RNMeshSdkSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  }
}
